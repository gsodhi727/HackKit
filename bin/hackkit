#!/usr/bin/env bash
# ============================================================
#  HackKit — Control Center / Launcher
#  Version : 2.1.0
#  Author  : gsodhi727  (github.com/gsodhi727/hackkit)
#  License : MIT
#
#  After installation, just type:  hackkit
#  ...to open the interactive menu, or use subcommands:
#
#    hackkit recon  -d target.com
#    hackkit fuzz   -u https://target.com
#    hackkit xss    -d target.com
#    hackkit doctor            # health-check installed tools
#    hackkit tools             # list installed tools
#    hackkit update            # update tools + templates
#    hackkit version | help
# ============================================================
set -uo pipefail

# ──────────────────────── COLOURS ────────────────────────────
RED='\033[0;31m';  GREEN='\033[0;32m'; YELLOW='\033[1;33m'
BLUE='\033[0;34m'; CYAN='\033[0;36m';  BOLD='\033[1m'
DIM='\033[2m';     RESET='\033[0m'

HACKKIT_VERSION="2.1.0"

# ──────────────── LOCATE THE REPO / SCRIPTS ──────────────────
# Resolve where HackKit lives so the launcher works whether it's
# run from /usr/local/bin (symlink), /opt/hackkit, or a clone.
resolve_home() {
  if [[ -n "${HACKKIT_HOME:-}" && -d "$HACKKIT_HOME/scripts" ]]; then
    echo "$HACKKIT_HOME"; return
  fi
  local src="${BASH_SOURCE[0]}"
  while [[ -h "$src" ]]; do
    local dir; dir="$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  local bindir; bindir="$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)"
  local root; root="$(cd "$bindir/.." >/dev/null 2>&1 && pwd)"
  if [[ -d "$root/scripts" ]]; then echo "$root"; return; fi
  for cand in /opt/hackkit "$HOME/hackkit" "$HOME/tools/hackkit"; do
    [[ -d "$cand/scripts" ]] && { echo "$cand"; return; }
  done
  echo "$root"
}

HOME_DIR="$(resolve_home)"
SCRIPTS="$HOME_DIR/scripts"
WORDLISTS_DIR="${WORDLISTS:-$HOME/wordlists}"
TOOLS_DIR="${TOOLS:-$HOME/tools}"
VENV="${HACKKIT_VENV:-$HOME/.hackkit-venv}"

# State / config
CONFIG_DIR="$HOME/.hackkit"
CONFIG_FILE="$CONFIG_DIR/config.env"
LOCK_FILE="$CONFIG_DIR/tools.lock"
GO_MANIFEST="$HOME_DIR/manifests/go-tools.txt"
WORKSPACES_DIR="${HACKKIT_WORKSPACES:-$PWD/workspaces}"

# Load saved API keys/config so pipelines inherit them.
load_config() { [[ -f "$CONFIG_FILE" ]] && set -a && . "$CONFIG_FILE" && set +a || true; }

# ──────────────────────── BANNER ─────────────────────────────
banner() {
cat <<'EOF'

  ██╗  ██╗ █████╗  ██████╗██╗  ██╗██╗  ██╗██╗████████╗
  ██║  ██║██╔══██╗██╔════╝██║ ██╔╝██║ ██╔╝██║╚══██╔══╝
  ███████║███████║██║     █████╔╝ █████╔╝ ██║   ██║
  ██╔══██║██╔══██║██║     ██╔═██╗ ██╔═██╗ ██║   ██║
  ██║  ██║██║  ██║╚██████╗██║  ██╗██║  ██╗██║   ██║
  ╚═╝  ╚═╝╚═╝  ╚═╝ ╚═════╝╚═╝  ╚═╝╚═╝  ╚═╝╚═╝   ╚═╝

EOF
  echo -e "${CYAN}${BOLD}  Control Center  v${HACKKIT_VERSION}  ·  by gsodhi727${RESET}"
  echo -e "${DIM}  home: $HOME_DIR${RESET}"
  echo ""
}

info()  { echo -e "${BLUE}[*]${RESET} $*"; }
ok()    { echo -e "${GREEN}[✓]${RESET} $*"; }
warn()  { echo -e "${YELLOW}[!]${RESET} $*"; }
err()   { echo -e "${RED}[✗]${RESET} $*"; }

require_script() {
  local s="$1"
  if [[ ! -f "$s" ]]; then
    err "Script not found: $s"
    warn "Is HackKit installed? Set HACKKIT_HOME or reinstall with: sudo bash install.sh"
    exit 1
  fi
}

# ──────────────── SUBCOMMAND: recon/fuzz/xss ─────────────────
cmd_recon() { require_script "$SCRIPTS/recon/recon.sh";          bash "$SCRIPTS/recon/recon.sh" "$@"; }
cmd_fuzz()  { require_script "$SCRIPTS/fuzzing/fuzz.sh";          bash "$SCRIPTS/fuzzing/fuzz.sh" "$@"; }
cmd_xss()   { require_script "$SCRIPTS/exploitation/xss-hunt.sh"; bash "$SCRIPTS/exploitation/xss-hunt.sh" "$@"; }
cmd_update(){ require_script "$SCRIPTS/utilities/update.sh";      bash "$SCRIPTS/utilities/update.sh" "$@"; }

# ──────────────── SUBCOMMAND: tools ──────────────────────────
cmd_tools() {
  echo -e "${CYAN}${BOLD}Go / binary tools dir:${RESET} ${GOPATH:-$HOME/go}/bin"
  ls "${GOPATH:-$HOME/go}/bin" 2>/dev/null | column 2>/dev/null || ls "${GOPATH:-$HOME/go}/bin" 2>/dev/null
  echo ""
  echo -e "${CYAN}${BOLD}Python tools dir:${RESET} $TOOLS_DIR"
  ls "$TOOLS_DIR" 2>/dev/null || warn "No Python tools dir yet."
}

# ──────────────── SUBCOMMAND: doctor ─────────────────────────
# Health-check: verify the core tools are actually on PATH.
cmd_doctor() {
  banner
  echo -e "${CYAN}${BOLD}  ▸ Environment health check${RESET}\n"

  local present=0 missing=0
  check() {
    local t="$1"
    if command -v "$t" &>/dev/null; then
      printf "  ${GREEN}[✓]${RESET} %-18s ${DIM}%s${RESET}\n" "$t" "$(command -v "$t")"
      ((present++)) || true
    else
      printf "  ${RED}[✗]${RESET} %-18s ${DIM}not found${RESET}\n" "$t"
      ((missing++)) || true
    fi
  }

  echo -e "${BOLD}  Core runtimes${RESET}"
  for t in go python3 git curl jq; do check "$t"; done

  echo -e "\n${BOLD}  Recon${RESET}"
  for t in subfinder assetfinder amass httpx dnsx naabu katana gau waybackurls; do check "$t"; done

  echo -e "\n${BOLD}  Fuzzing / scanning${RESET}"
  for t in ffuf feroxbuster gobuster nuclei dalfox; do check "$t"; done

  echo -e "\n${BOLD}  Utilities${RESET}"
  for t in anew qsreplace unfurl notify gowitness; do check "$t"; done

  echo -e "\n${BOLD}  Data${RESET}"
  [[ -d "$WORDLISTS_DIR/SecLists" ]] && ok "SecLists present → $WORDLISTS_DIR/SecLists" || err "SecLists missing (expected $WORDLISTS_DIR/SecLists)"
  [[ -f "$WORDLISTS_DIR/resolvers.txt" ]] && ok "resolvers.txt present" || warn "resolvers.txt missing"
  [[ -d "$HOME/nuclei-templates" ]] && ok "nuclei-templates present" || warn "nuclei-templates missing (run: hackkit update)"
  [[ -d "$VENV" ]] && ok "Python venv → $VENV" || warn "Python venv missing ($VENV)"

  echo ""
  echo -e "${CYAN}${BOLD}  ────────────────────────────────────────────${RESET}"
  echo -e "  ${GREEN}present: $present${RESET}   ${RED}missing: $missing${RESET}"
  if (( missing > 0 )); then
    warn "Some tools are missing. Try:  ${BOLD}hackkit update${RESET}  or re-run the installer."
    warn "If tools are installed but 'not found', your PATH may be missing \$GOPATH/bin — open a new shell."
  else
    ok "All core tools present. Happy (authorized) hunting! 🎯"
  fi
}

# ──────────────── SUBCOMMAND: config ─────────────────────────
# Manage API keys / tokens for the tools (subfinder, chaos, github, …).
# Stored in ~/.hackkit/config.env (chmod 600) and exported to pipelines.
KNOWN_KEYS="GITHUB_TOKEN PDCP_API_KEY CHAOS_KEY SHODAN_API_KEY CENSYS_API_ID CENSYS_API_SECRET SECURITYTRAILS_KEY VIRUSTOTAL_KEY BINARYEDGE_KEY"

config_ensure() {
  mkdir -p "$CONFIG_DIR"; chmod 700 "$CONFIG_DIR" 2>/dev/null || true
  [[ -f "$CONFIG_FILE" ]] || { : > "$CONFIG_FILE"; }
  chmod 600 "$CONFIG_FILE" 2>/dev/null || true
}

config_set() {
  local key="$1" val="$2"
  [[ -z "$key" || -z "${val:-}" ]] && { err "Usage: hackkit config set KEY VALUE"; return 1; }
  config_ensure
  # strip any existing line, then append
  grep -vE "^export ${key}=" "$CONFIG_FILE" > "$CONFIG_FILE.tmp" 2>/dev/null || true
  mv "$CONFIG_FILE.tmp" "$CONFIG_FILE"
  printf 'export %s=%q\n' "$key" "$val" >> "$CONFIG_FILE"
  chmod 600 "$CONFIG_FILE"
  ok "Saved $key → $CONFIG_FILE"
  # Keep subfinder's provider config in sync for recognised keys.
  config_sync_subfinder
}

config_list() {
  config_ensure
  echo -e "${CYAN}${BOLD}  Config:${RESET} $CONFIG_FILE\n"
  if [[ ! -s "$CONFIG_FILE" ]]; then
    warn "No keys set yet. Add one with:  hackkit config set GITHUB_TOKEN <token>"
    echo -e "\n${DIM}  Recognised keys: $KNOWN_KEYS${RESET}"
    return 0
  fi
  # Print keys with masked values.
  while IFS= read -r line; do
    [[ "$line" =~ ^export ]] || continue
    local kv="${line#export }"; local k="${kv%%=*}"; local v="${kv#*=}"
    v="${v%\"}"; v="${v#\"}"; v="${v#\'}"; v="${v%\'}"
    local masked="****"
    [[ ${#v} -gt 4 ]] && masked="${v:0:2}****${v: -2}"
    printf "  ${GREEN}%-22s${RESET} ${DIM}%s${RESET}\n" "$k" "$masked"
  done < "$CONFIG_FILE"
}

# Write ~/.config/subfinder/provider-config.yaml from known keys.
config_sync_subfinder() {
  config_ensure; load_config
  local pc="$HOME/.config/subfinder/provider-config.yaml"
  mkdir -p "$(dirname "$pc")"
  {
    [[ -n "${CHAOS_KEY:-}"           ]] && printf 'chaos:\n  - %s\n'           "$CHAOS_KEY"
    [[ -n "${SHODAN_API_KEY:-}"      ]] && printf 'shodan:\n  - %s\n'          "$SHODAN_API_KEY"
    [[ -n "${SECURITYTRAILS_KEY:-}"  ]] && printf 'securitytrails:\n  - %s\n'  "$SECURITYTRAILS_KEY"
    [[ -n "${VIRUSTOTAL_KEY:-}"      ]] && printf 'virustotal:\n  - %s\n'      "$VIRUSTOTAL_KEY"
    [[ -n "${BINARYEDGE_KEY:-}"      ]] && printf 'binaryedge:\n  - %s\n'      "$BINARYEDGE_KEY"
    [[ -n "${GITHUB_TOKEN:-}"        ]] && printf 'github:\n  - %s\n'          "$GITHUB_TOKEN"
    if [[ -n "${CENSYS_API_ID:-}" && -n "${CENSYS_API_SECRET:-}" ]]; then
      printf 'censys:\n  - %s:%s\n' "$CENSYS_API_ID" "$CENSYS_API_SECRET"
    fi
  } > "$pc" 2>/dev/null && chmod 600 "$pc" 2>/dev/null || true
}

cmd_config() {
  local sub="${1:-list}"; [[ $# -gt 0 ]] && shift || true
  case "$sub" in
    set)             config_set "${1:-}" "${2:-}" ;;
    list|ls|"")      config_list ;;
    path)            echo "$CONFIG_FILE" ;;
    edit)            config_ensure; "${EDITOR:-vi}" "$CONFIG_FILE" ;;
    sync|sync-subfinder) config_sync_subfinder && ok "subfinder provider config synced." ;;
    *) err "Unknown: hackkit config $sub"; echo "  Try: set | list | path | edit | sync" ;;
  esac
}

# ──────────────── SUBCOMMAND: workspace ──────────────────────
# Scaffold a per-target results directory.
cmd_workspace() {
  local target="${1:-}"
  if [[ -z "$target" ]]; then
    echo -e "${CYAN}${BOLD}  Workspaces under:${RESET} $WORKSPACES_DIR\n"
    if [[ -d "$WORKSPACES_DIR" ]]; then
      ls -1 "$WORKSPACES_DIR" 2>/dev/null | sed 's/^/  • /' || true
    else
      warn "No workspaces yet. Create one:  hackkit workspace example.com"
    fi
    return 0
  fi
  # sanitise target into a safe dir name
  local safe; safe="$(echo "$target" | tr '/:' '__' | tr -cd 'A-Za-z0-9._-')"
  local ws="$WORKSPACES_DIR/$safe"
  mkdir -p "$ws"/{recon,fuzzing,xss,scans,screenshots,loot}
  if [[ ! -f "$ws/notes.md" ]]; then
    cat > "$ws/notes.md" <<NOTES
# $target — engagement notes

- Created: $(date '+%Y-%m-%d %H:%M')
- Scope / authorization: <paste authorized scope here>

## Findings

## To-do
NOTES
  fi
  ok "Workspace ready → ${BOLD}$ws${RESET}"
  echo -e "${DIM}    recon/  fuzzing/  xss/  scans/  screenshots/  loot/  notes.md${RESET}"
  echo -e "  Next:  ${BOLD}hackkit recon -d $target -o $ws/recon${RESET}"
}

# ──────────────── SUBCOMMAND: freeze ─────────────────────────
# Rewrite manifests/go-tools.txt version column from the lockfile,
# so the next install reproduces today's exact toolset.
cmd_freeze() {
  [[ -f "$LOCK_FILE" ]]     || { err "No lockfile at $LOCK_FILE — run the installer first."; return 1; }
  [[ -f "$GO_MANIFEST" ]]   || { err "No manifest at $GO_MANIFEST."; return 1; }
  [[ -w "$GO_MANIFEST" ]]   || { err "Manifest not writable: $GO_MANIFEST"; return 1; }
  local tmp; tmp="$(mktemp)"
  local changed=0
  while IFS= read -r line; do
    # passthrough comments/blanks
    if [[ -z "$line" || "${line// }" == "" || "${line:0:1}" == "#" ]]; then
      printf '%s\n' "$line" >> "$tmp"; continue
    fi
    local name module version rest
    read -r name module version rest <<<"$line"
    local locked; locked="$(awk -v n="$name" '$1==n{print $2; exit}' "$LOCK_FILE")"
    if [[ -n "$locked" && "$locked" != "$version" ]]; then
      printf '%-18s %-56s %s\n' "$name" "$module" "$locked" >> "$tmp"
      changed=$((changed+1))
    else
      printf '%s\n' "$line" >> "$tmp"
    fi
  done < "$GO_MANIFEST"
  mv "$tmp" "$GO_MANIFEST"
  ok "Froze $changed tool version(s) into manifests/go-tools.txt"
  echo -e "${DIM}  Commit the manifest to reproduce this toolset elsewhere.${RESET}"
}

# ──────────────── SUBCOMMAND: completion ─────────────────────
cmd_completion() {
  local shell="${1:-bash}"
  case "$shell" in
    bash)
      cat <<'BASHC'
# hackkit bash completion — add to ~/.bashrc:
#   source <(hackkit completion bash)
_hackkit() {
  local cur prev cmds
  cur="${COMP_WORDS[COMP_CWORD]}"
  cmds="recon fuzz xss doctor tools update config workspace freeze completion version help"
  if [[ $COMP_CWORD -eq 1 ]]; then
    COMPREPLY=( $(compgen -W "$cmds" -- "$cur") ); return
  fi
  case "${COMP_WORDS[1]}" in
    config)    COMPREPLY=( $(compgen -W "set list path edit sync" -- "$cur") ) ;;
    fuzz)      COMPREPLY=( $(compgen -W "-u -m -o -t" -- "$cur") ) ;;
    completion)COMPREPLY=( $(compgen -W "bash zsh" -- "$cur") ) ;;
  esac
}
complete -F _hackkit hackkit
BASHC
      ;;
    zsh)
      cat <<'ZSHC'
# hackkit zsh completion — add to ~/.zshrc:
#   source <(hackkit completion zsh)
_hackkit() {
  local -a cmds
  cmds=(recon fuzz xss doctor tools update config workspace freeze completion version help)
  _describe 'command' cmds
}
compdef _hackkit hackkit
ZSHC
      ;;
    *) err "Unknown shell: $shell (use bash or zsh)"; return 1 ;;
  esac
}

# ──────────────── SUBCOMMAND: help / version ─────────────────
cmd_version() { echo "hackkit v${HACKKIT_VERSION}"; }

cmd_help() {
  banner
  echo -e "$(cat <<HELP
  ${BOLD}USAGE${RESET}
    hackkit                      Open the interactive menu
    hackkit <command> [args]     Run a command directly

  ${BOLD}COMMANDS${RESET}
    recon   -d <domain>          Full recon pipeline (subs → alive → urls → nuclei)
    fuzz    -u <url> [-m mode]   Content/vhost/param fuzzing
    xss     -d <domain>          XSS hunting pipeline
    doctor                       Verify installed tools & data (health check)
    tools                        List installed tools
    update                       Update tools + nuclei templates
    config  [set|list|…]         Manage API keys/tokens for the tools
    workspace [target]           Scaffold / list per-target results dirs
    freeze                       Pin installed tool versions into the manifest
    completion [bash|zsh]        Print shell completion script
    version                      Print version
    help                         Show this help

  ${BOLD}EXAMPLES${RESET}
    hackkit recon -d example.com -o out/
    hackkit fuzz  -u https://example.com -m dir
    hackkit xss   -d example.com -b https://cb.example.net
    hackkit config set GITHUB_TOKEN ghp_xxx
    hackkit workspace example.com
    hackkit doctor

  ${DIM}Only test assets you are explicitly authorized to test.${RESET}
HELP
)"
}

# ──────────────── INTERACTIVE MENU ───────────────────────────
interactive_menu() {
  banner
  echo -e "${BOLD}  What would you like to do?${RESET}\n"
  echo -e "  ${GREEN}${BOLD}[1]${RESET}  Recon pipeline        ${DIM}subfinder → httpx → gau → nuclei${RESET}"
  echo -e "  ${GREEN}${BOLD}[2]${RESET}  Fuzzing               ${DIM}directories / vhosts / parameters${RESET}"
  echo -e "  ${GREEN}${BOLD}[3]${RESET}  XSS hunt              ${DIM}gather → filter → dalfox${RESET}"
  echo -e "  ${BLUE}${BOLD}[4]${RESET}  Doctor (health check) ${DIM}verify tools are installed${RESET}"
  echo -e "  ${BLUE}${BOLD}[5]${RESET}  List installed tools"
  echo -e "  ${YELLOW}${BOLD}[6]${RESET}  Update tools & templates"
  echo -e "  ${CYAN}${BOLD}[7]${RESET}  New workspace         ${DIM}scaffold a per-target dir${RESET}"
  echo -e "  ${CYAN}${BOLD}[8]${RESET}  Configure API keys"
  echo -e "  ${CYAN}${BOLD}[h]${RESET}  Help        ${DIM}[q] Quit${RESET}\n"
  echo -ne "${CYAN}${BOLD}  Choice: ${RESET}"
  read -r choice
  echo ""
  case "${choice,,}" in
    1) read -rp "  Target domain: " d; [[ -n "$d" ]] && cmd_recon -d "$d" || err "No domain given." ;;
    2) read -rp "  Target URL: " u
       read -rp "  Mode [dir/vhost/param] (default dir): " m
       [[ -n "$u" ]] && cmd_fuzz -u "$u" -m "${m:-dir}" || err "No URL given." ;;
    3) read -rp "  Target domain: " d; [[ -n "$d" ]] && cmd_xss -d "$d" || err "No domain given." ;;
    4) cmd_doctor ;;
    5) cmd_tools ;;
    6) cmd_update ;;
    7) read -rp "  Target name: " t; cmd_workspace "$t" ;;
    8) cmd_config list ;;
    h|help) cmd_help ;;
    q|quit|exit) echo -e "${DIM}  Bye!${RESET}" ;;
    *) err "Invalid choice: $choice" ;;
  esac
}

# ──────────────────────── DISPATCH ───────────────────────────
main() {
  local cmd="${1:-}"
  [[ $# -gt 0 ]] && shift || true
  case "$cmd" in
    ""|menu)          interactive_menu ;;
    recon)            cmd_recon  "$@" ;;
    fuzz)             cmd_fuzz   "$@" ;;
    xss)              cmd_xss    "$@" ;;
    update|up)        cmd_update "$@" ;;
    tools|ls)         cmd_tools ;;
    doctor|check|dr)  cmd_doctor ;;
    config|cfg)       cmd_config "$@" ;;
    workspace|ws)     cmd_workspace "$@" ;;
    freeze|pin)       cmd_freeze ;;
    completion)       cmd_completion "$@" ;;
    version|-v|--version) cmd_version ;;
    help|-h|--help)   cmd_help ;;
    *) err "Unknown command: $cmd"; echo ""; cmd_help; exit 1 ;;
  esac
}

load_config
main "$@"
